{
  "name": "linqor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "dev:web": "pnpm --filter @linqor/web dev",
    "dev:android": "pnpm --filter @linqor/android start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check eslint.config.mjs vitest.config.ts packages/validation/src/index.test.ts .prettierrc.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}